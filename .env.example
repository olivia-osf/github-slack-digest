# GitHub OAuth App — create at https://github.com/settings/developers
# Callback URL to register: {YOUR_DEPLOYED_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack App — create at https://api.slack.com/apps
# Redirect URL to register: {YOUR_DEPLOYED_URL}/api/auth/slack/callback
# Required bot scopes: chat:write, channels:read, groups:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional — Vercel KV / Upstash Redis REST credentials for token persistence
# in production. If unset, tokens are stored in a local JSON file, which is
# fine for local dev but will NOT persist across serverless deploys/restarts.
# Attach a KV store to your Vercel project and these are auto-populated.
KV_REST_API_URL=
KV_REST_API_TOKEN=
